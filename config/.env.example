# DevServer v2 — environment configuration template
#
# Copy this file to the project root as `.env` and fill in your own values:
#
#     cp config/.env.example .env
#
# Do NOT commit `.env` — it is gitignored. This template file is the only
# env file that should ever be tracked.

# ─── Paths ───────────────────────────────────────────────
# Absolute path to this repo on your machine. All other paths derive from it.
DEVSERVER_ROOT=/path/to/devserver
WORKTREE_DIR=${DEVSERVER_ROOT}/worktrees
LOG_DIR=${DEVSERVER_ROOT}/logs/tasks

# ─── PostgreSQL ──────────────────────────────────────────
# Required. The web and worker services both read these.
# Change the password before starting the stack — do NOT keep "changeme" in
# anything facing a real network.
DATABASE_URL=postgresql://devserver:changeme@127.0.0.1:5432/devserver
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=devserver
PGPASSWORD=changeme
PGDATABASE=devserver
# Docker only: set to 1 to use a PostgreSQL outside the bundled container
# (host OS or external server). The lifecycle scripts then skip the bundled DB.
# Left unset, the scripts auto-detect a host Postgres on the DB port.
# The Settings page (and Setup wizard) Database card manages this for you.
# DEVSERVER_HOST_DB=1
#
# Docker only: the host/port the web + worker CONTAINERS use to reach Postgres.
# These differ from PG* above because a container can't reach the host's
# 127.0.0.1, and the bundled DB answers on its internal port 5432 (not the
# host-published PGPORT). Defaults: postgres:5432 (the bundled container).
# The Database card sets these automatically — bundled→postgres:5432,
# host-OS→host.docker.internal:<port>, external→<remote host:port>.
# PGHOST_CONTAINER=postgres
# PGPORT_CONTAINER=5432

# ─── Git ─────────────────────────────────────────────────
# Set to true only if your Gitea uses a self-signed cert or an IP-based URL
# with a cert mismatch. Leave false in production.
GIT_SSL_NO_VERIFY=false
# Identity used for every commit the agent makes. Must be quoted if it
# contains a space — bash source-parses this file in a few of the scripts.
GIT_USER_EMAIL=devserver@example.com
GIT_USER_NAME="DevServer Agent"

# ─── Git host (Gitea / GitHub) ───────────────────────────
# Each repo records its own provider ('gitea' or 'github') and may carry
# its own per-repo API token. The values below are global fallbacks used
# only when a repo of that provider has no token of its own.
#
# Gitea (or Forgejo) — self-hosted instance.
GITEA_URL=https://your-gitea.example.com
GITEA_OWNER=your-org
GITEA_TOKEN=replace-with-a-gitea-personal-access-token
#
# GitHub — a classic or fine-grained Personal Access Token with `repo`
# scope (or a GitHub App installation token). Only used by repos whose
# provider is 'github'. The Gitea token is never reused for GitHub.
GITHUB_TOKEN=replace-with-a-github-personal-access-token

# ─── Notification channels ──────────────────────────────
# Every task lifecycle event (start / success / failure / budget alerts /
# vendor failover / preflight block / operator messages) fans out to
# every configured channel in parallel. Each channel is opt-in — leave
# its vars blank to disable. Zero DB changes required.

# Telegram — bot token + chat id enable rich Markdown notifications AND
# two-way commands (/approve, /reject, /cancel, /retry, /reply, /status,
# /inbox, /pause, /resume, /mode, /digest, /budget).
# Create a bot via @BotFather; CHAT_ID is your own user id (message @userinfobot).
TELEGRAM_BOT_TOKEN=replace-with-a-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-your-numeric-chat-id

# Discord — channel webhook URL. Colour-coded embeds for task cards.
# Server settings → Integrations → Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK_URL=


# ─── Agent backends (primary + fallbacks) ──────────────
# DevServer can drive multiple coding-agent CLIs via the AgentBackend
# abstraction (apps/worker/src/services/agent_backends.py). Only the
# Anthropic backend is production-tested; the others are wired up so
# you can experiment with them as wingmen without a refactor.
#
# Every task carries a per-task "billing mode" that is vendor-agnostic:
#   • API Platform — worker runs the CLI with the vendor's API-key env
#                    var below. Per-token billing against that account.
#   • Max          — worker strips the API-key env var before spawning
#                    the CLI, so the CLI falls back to its own OAuth /
#                    subscription login (Claude Max, ChatGPT Plus via
#                    `codex login`, Google OAuth for Gemini, Qwen OAuth).
#                    Use this if you already pay the vendor a flat
#                    monthly fee and don't want per-token metering.

# ─── Anthropic (primary, Claude Code CLI) ──────────────
# Install: Claude Code CLI (npm i -g @anthropic-ai/claude-code).
# API Platform: set ANTHROPIC_API_KEY below.
# Max:          run `claude login` on the worker host, leave the key empty.
ANTHROPIC_API_KEY=sk-ant-api03-replace-with-your-key
CLAUDE_BIN=claude
CLAUDE_MAX_TIMEOUT=3600
CLAUDE_ACTIVITY_TIMEOUT=300
# Max mode, all-in-Docker only: the host directory holding your `claude login`
# OAuth credentials, bind-mounted read-only into the worker container (see the
# commented claude_auth volume in docker/docker-compose.yml). On macOS/Linux the
# ${HOME}/.claude default works out of the box, so you can leave this blank.
# On native Windows, ${HOME} is NOT set for `docker compose`, so you MUST set
# this explicitly to your host config dir, using forward slashes, e.g.:
#   CLAUDE_CONFIG_DIR=C:/Users/<you>/.claude
# CLAUDE_CONFIG_DIR=

# ─── Local embeddings (semantic memory recall) ─────────
# Memory recall now embeds fully locally via fastembed (ONNX/CPU). No cloud
# API and no key required — the legacy Voyage path (which (mis)used
# ANTHROPIC_API_KEY) is gone. The model is downloaded + cached on first use.
# Must be a 768-dim fastembed model to match the DB column, e.g.
# BAAI/bge-base-en-v1.5 (default) or jinaai/jina-embeddings-v2-base-code
# (code-aware). Switching to a different dimension needs a re-embed +
# migration — see apps/worker/scripts/reembed_memory.py.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ─── OpenAI (fallback — Codex CLI) ─────────────────────
# Install: `npm i -g @openai/codex` or `brew install --cask codex`.
# API Platform: set OPENAI_API_KEY below.
# Max:          run `codex login` (uses ChatGPT Plus OAuth); leave key empty.
OPENAI_API_KEY=
CODEX_BIN=codex
# Optional — point Codex at an OpenAI-compatible endpoint other than
# api.openai.com. Useful for Azure OpenAI / Azure AI Foundry, vLLM,
# LiteLLM, or a local proxy. Leave blank to use the default OpenAI
# endpoint.
#
# Azure AI Foundry example (include the trailing slash — DevServer
# automatically appends /openai when building the codex argv):
#   OPENAI_BASE_URL=https://<your-resource>.openai.azure.com/
# For Azure you also need an API version that exposes the Responses API.
# Verified working as of 2026-04:
#   OPENAI_API_VERSION=2025-03-01-preview
# When using Azure, OPENAI_API_KEY must be your Azure resource key, and
# the model id you pick in the task form must match a deployment name
# you've created in Azure Foundry (NOT the underlying model family).
OPENAI_BASE_URL=
OPENAI_API_VERSION=2025-03-01-preview

# ─── Google (Antigravity CLI — `agy`) ──────────────────
# Google RETIRED the Gemini CLI on 2026-06-18 (gemini commands now 410 Gone)
# and replaced it with the Antigravity CLI, invoked as `agy`.
# Install: `curl -fsSL https://antigravity.google/cli/install.sh | bash`.
# Max (subscription, recommended): use your Google AI Pro / Ultra plan. Run
#   `agy` once interactively and sign in with the Google account that holds the
#   subscription (browser OAuth). Then set the task's Billing to "Max" — the
#   worker strips the key/Vertex env vars so `agy` uses the OAuth subscription.
# API Platform: set GEMINI_API_KEY (from https://aistudio.google.com) — the
#   worker reuses it for `agy` (bridged to ANTIGRAVITY_API_KEY). You may set
#   ANTIGRAVITY_API_KEY explicitly instead; if so it takes precedence.
# Model slugs (verified on agy 1.0.10): gemini-3.1-pro, gemini-3.5-flash.
GEMINI_API_KEY=
# ANTIGRAVITY_API_KEY=   # optional; defaults to GEMINI_API_KEY or OAuth

# ─── GLM / Zhipu AI (fallback — glm launcher wrapping Claude Code CLI)
#
# GLM-5.1 scores 58.4% on SWE-bench Pro (beats Claude Opus 4.6) and
# costs ~$0.95/1M input tokens — ~8x cheaper than Claude on output.
# The ``glm`` binary is Claude Code CLI redirected to Zhipu's
# Anthropic-compatible API, so it uses the exact same flags, tools,
# JSON output, and session resume as Claude.
#
# ── Install:
#   Prerequisites: Claude Code CLI must be installed first.
#   curl -fsSL https://raw.githubusercontent.com/xqsit94/glm/main/install.sh | bash
#
# ── How to get your API key:
#   1. Go to https://open.bigmodel.cn and click "Register" (注册)
#   2. Sign up with email or phone number (international emails work)
#   3. After login, go to Console → API Keys (控制台 → API密钥)
#   4. Click "Create API Key" (创建API密钥)
#   5. Copy the key (starts with a long alphanumeric string)
#   6. Paste it below as GLM_API_KEY
#   New accounts get free credits — enough for initial testing.
#
# API Platform: set GLM_API_KEY below.
# Max:          run `glm` interactively once to store auth; leave key empty.
GLM_API_KEY=

# ─── PR Preflight ────────────────────────────────────────
# Comma-separated glob patterns for files to skip during PR preflight
# size and secret checks. Useful for test databases, fixtures, etc.
# Example: "*.sqlite,*.sqlite3,test_data/**"
PREFLIGHT_IGNORE_PATTERNS=

# ─── Obsidian ────────────────────────────────────────────
# Absolute path to the Obsidian vault folder where generated plan
# markdown files are saved (named <plan-key>.md).
# Leave empty to disable plan-to-Obsidian export.
OBSIDIAN_FOLDER=

# ─── Web UI ──────────────────────────────────────────────
# Public URLs the browser uses to reach the dashboard. Update if you put
# DevServer behind a reverse proxy or expose it on a non-default host.
NEXT_PUBLIC_WS_URL=ws://localhost:3200/api/ws
NEXT_PUBLIC_API_URL=http://localhost:3200/api

# ─── Worker ──────────────────────────────────────────────
WORKER_HOST=0.0.0.0
WORKER_PORT=8000
# Maximum number of tasks the PgQueuer consumer will run in parallel.
WORKER_CONCURRENCY=2
# Docker only: override so the web container reaches the worker by its
# service name instead of localhost.
# WORKER_URL=http://worker:8000

# Port the Next.js dashboard listens on (host process + Docker container,
# and the port the worker uses to reach the web API). Default 3200.
WEB_PORT=3200

# ─── OpenTelemetry (governance tracing, optional) ────────────────────────
# Export the task pipeline as OTLP spans carrying governance attributes
# (reality score, budget burn, secret-scan hits, error class, vendor
# failover) to any OTLP collector — Langfuse, Grafana Tempo, Datadog, Jaeger.
# Tracing is OFF by default and a pure no-op unless the endpoint below is set
# AND the otel extras are installed (`uv sync --extra otel`). Zero overhead
# when unset. See services/telemetry.py.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional service.name reported on every span (default: devserver-worker).
# OTEL_SERVICE_NAME=devserver-worker

